#!/usr/bin/env python3
"""template-drift: say which repos carry an old copy of the AGENTS.md flow.

  template-drift [REPO ...]       (default: the current directory)

A repo that copied `templates/AGENTS.md` carries its first line, `<!-- jstack-template: X.Y.Z -->`. The rules in that
copy are the ones an agent is sure to read, so an old copy means new rules are not followed. One line per repo:

  ok     the copy is the current one
  stale  the copy is older, or has no marker (it predates the markers): copy the flow and the session rules again
  ahead  the copy is newer than this machine's jstack: update jstack here (`git pull --ff-only && ./install.sh`)
  skip   no AGENTS.md, or it does not use the jstack flow

Exit 1 when any repo is stale or ahead, 2 on a usage error. Read-only.
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
TEMPLATE = HERE.parents[2] / "templates" / "AGENTS.md"
MARKER = re.compile(r"<!--\s*jstack-template:\s*(\d+)\.(\d+)\.(\d+)\s*-->")
FLOW = "## End-to-end flow (jstack)"


def marker(text: str):
    found = MARKER.search(text)
    return tuple(int(x) for x in found.groups()) if found else None


def dotted(version) -> str:
    return ".".join(map(str, version))


def check(repo: Path, current) -> tuple[str, str]:
    agents = repo / "AGENTS.md"
    if not agents.is_file():
        return "skip", "no AGENTS.md"
    text = agents.read_text(errors="replace")
    if FLOW not in text:
        return "skip", "AGENTS.md does not use the jstack flow"
    mine = marker(text)
    if mine is None:
        return "stale", (f"the copy has no version marker, so it predates {dotted(current)}; copy the flow, the session rules and "
                         "the settings block from templates/AGENTS.md again and keep the project's own rules")
    if mine < current:
        return "stale", (f"the copy is from {dotted(mine)}, the current template is {dotted(current)}; copy the flow and the "
                         "session rules from templates/AGENTS.md again and keep the project's own rules")
    if mine > current:
        return "ahead", f"the copy is from {dotted(mine)}, this machine's jstack has {dotted(current)}: run `git pull --ff-only && ./install.sh` in the jstack checkout"
    return "ok", f"template {dotted(current)}"


def main(argv: list[str]) -> int:
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__)
        return 0
    current = marker(TEMPLATE.read_text()) if TEMPLATE.is_file() else None
    if current is None:
        print(f"template-drift: {TEMPLATE} has no `<!-- jstack-template: X.Y.Z -->` marker", file=sys.stderr)
        return 2
    repos = [Path(a) for a in argv] or [Path.cwd()]
    worst = 0
    for repo in repos:
        if not repo.is_dir():
            print(f"template-drift: {repo} is not a directory", file=sys.stderr)
            return 2
        status, detail = check(repo, current)
        print(f"{status:5} {repo}: {detail}")
        if status in ("stale", "ahead"):
            worst = 1
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
