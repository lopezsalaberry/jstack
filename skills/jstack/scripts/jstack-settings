#!/usr/bin/env python3
"""jstack-settings: print the resolved jstack settings for a repo.

  jstack-settings [--repo PATH] [--json] [KEY]

Precedence: environment JSTACK_<KEY>, then the `## jstack settings` block of the repo's AGENTS.md
(`key: value` lines), then the operator's own file (the same lines, for every repo on the machine:
$JSTACK_USER_SETTINGS or ~/.config/jstack/settings), then the default. Without KEY prints every setting.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

SKILLS = Path(__file__).resolve().parents[2]
DEFAULTS = {
    "remote": "origin",
    "integration_branch": None,  # derived from the remote
    "ui_paths": "",
    "design_tokens": "design/tokens.json",
    "design_check": "",
    "verify_mode": "visible",
    "reviewer_models": "auto",
    # Measured in Open Training, 2026-11-14/15: the three tickets escalated to the operator were 3 of 14 on Sonnet,
    # none of 8 on Opus, all hard logic (a dual write, matching sessions, reading free text).
    "routing": "the strongest model (Opus) for bug fixes, data or schema changes, parsers and anything that reads outside input, auth and security, concurrency, and every UI or UX change; the fast model (Sonnet) for mechanical edits, docs, and small features that follow an existing pattern and change no data",
    "max_parallel": "",
    "computer_use": "",
    "quota_probe": shlex.quote(str(SKILLS / "wave" / "scripts" / "quota-probe")),  # a path may hold spaces
}
LINE = re.compile(r"^([a-z_]+):\s*(.*?)\s*$")


def pairs(lines) -> dict[str, str]:
    values = {}
    for line in lines:
        match = LINE.match(line)
        if match:
            values[match.group(1)] = re.sub(r"\s{2,}#.*$", "", match.group(2)).strip()
    return values


def block(agents: Path) -> dict[str, str]:
    """The `key: value` lines under the `## jstack settings` heading, up to the next heading."""
    return block_text(agents.read_text()) if agents.is_file() else {}


def block_text(text: str) -> dict[str, str]:
    inside, kept = False, []
    for line in text.splitlines():
        if re.match(r"^#{1,6}\s", line):
            inside = bool(re.match(r"^#{1,6}\s*jstack settings\s*$", line, re.I))
        elif inside:
            kept.append(line)
    return pairs(kept)


def user_values(env) -> dict[str, str]:
    path = Path(env.get("JSTACK_USER_SETTINGS") or Path.home() / ".config" / "jstack" / "settings")
    return pairs(path.read_text().splitlines()) if path.is_file() else {}


def default_branch(repo: Path, remote: str = "origin") -> str:
    proc = subprocess.run(["git", "-C", str(repo), "symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD"],
                          capture_output=True, text=True)
    return proc.stdout.strip().removeprefix(f"{remote}/") if proc.returncode == 0 and proc.stdout.strip() else "main"


def github_repo(url: str) -> str | None:
    """owner/name of a GitHub remote URL, or None for anything else."""
    found = re.match(r"^(?:git@|ssh://git@|https?://(?:[^@/]+@)?)github\.com[:/]+([^/]+)/(.+?)(?:\.git)?/?$", url.strip())
    return f"{found.group(1)}/{found.group(2)}" if found else None


def gh_env(repo: Path, remote: str) -> dict[str, str]:
    """The environment for a `gh` call about this checkout's pull requests: the repo is the one `remote` points to,
    so a fork whose `origin` is upstream asks its own repo. GH_REPO set by the caller wins."""
    env = dict(os.environ)
    if "GH_REPO" not in env:
        url = subprocess.run(["git", "-C", str(repo), "remote", "get-url", remote], capture_output=True, text=True).stdout
        if github_repo(url):
            env["GH_REPO"] = github_repo(url)
    return env


def resolve(repo: Path, env: dict[str, str] | None = None, configured: dict[str, str] | None = None) -> dict[str, str]:
    env = os.environ if env is None else env
    configured = block(repo / "AGENTS.md") if configured is None else configured
    mine = user_values(env)
    out: dict[str, str] = {}
    for key, default in DEFAULTS.items():  # `remote` comes first: the integration branch's default is read from it
        if f"JSTACK_{key.upper()}" in env:
            out[key] = env[f"JSTACK_{key.upper()}"]
        elif key in configured:
            out[key] = configured[key]
        elif key in mine:
            out[key] = mine[key]
        else:
            out[key] = default if default is not None else default_branch(repo, out["remote"])
    return out


def resolve_integrated(repo: Path, env: dict[str, str] | None = None) -> tuple[dict[str, str], str]:
    """The settings as the integration branch has them, and where they came from. A checkout on another branch (an
    orchestrator's program branch) may carry an older `AGENTS.md`; what a worker is told must not depend on that."""
    here = resolve(repo, env)
    ref = f"{here['remote']}/{here['integration_branch']}"
    remotes = subprocess.run(["git", "-C", str(repo), "remote"], capture_output=True, text=True).stdout.split()
    # This checkout may not name the remote at all (its AGENTS.md predates the `remote` line): try the others too.
    for name in [here["remote"]] + [r for r in remotes if r != here["remote"]]:
        tried = f"{name}/{here['integration_branch']}"
        shown = subprocess.run(["git", "-C", str(repo), "show", f"{tried}:AGENTS.md"], capture_output=True, text=True)
        if shown.returncode == 0:
            return resolve(repo, env, block_text(shown.stdout)), f"AGENTS.md on {tried}"
    return here, f"this checkout's AGENTS.md ({ref} has none or is not fetched)"


def glob_re(glob: str) -> re.Pattern:
    out, i = "", 0
    while i < len(glob):
        if glob[i:i + 3] == "**/":
            out, i = out + "(?:.*/)?", i + 3
        elif glob[i:i + 2] == "**":
            out, i = out + ".*", i + 2
        elif glob[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif glob[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(glob[i]), i + 1
    return re.compile("^" + out + "$")


def ui_files(values: dict[str, str], files: list[str]) -> list[str]:
    """The files that count as UI: those matching a glob of `ui_paths` and no `!glob` of it. Empty means none."""
    globs = [g.strip() for g in values["ui_paths"].split(",") if g.strip()]
    keep = [glob_re(g) for g in globs if not g.startswith("!")]
    drop = [glob_re(g[1:].strip()) for g in globs if g.startswith("!")]
    return [f for f in files if any(p.match(f) for p in keep) and not any(p.match(f) for p in drop)]


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("key", nargs="?")
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    values = resolve(args.repo)
    if args.key:
        if args.key not in values:
            print(f"jstack-settings: unknown key {args.key!r}; known: {', '.join(values)}", file=sys.stderr)
            sys.exit(2)
        print(values[args.key])
    elif args.json:
        print(json.dumps(values, indent=2))
    else:
        for key, value in values.items():
            print(f"{key}: {value}")


if __name__ == "__main__":
    main()
