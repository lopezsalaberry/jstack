#!/usr/bin/env python3
"""jstack-settings: print the resolved jstack settings for a repo.

  jstack-settings [--repo PATH] [--json] [KEY]

Precedence: environment JSTACK_<KEY>, then the `## jstack settings` block of the repo's AGENTS.md
(`key: value` lines), then the operator's own file (the same lines, for every repo on the machine:
$JSTACK_USER_SETTINGS or ~/.config/jstack/settings), then the default. Without KEY prints every setting.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

SKILLS = Path(__file__).resolve().parents[2]
DEFAULTS = {
    "integration_branch": None,  # derived from the remote
    "ui_paths": "",
    "design_tokens": "design/tokens.json",
    "design_check": "",
    "verify_mode": "visible",
    "reviewer_models": "auto",
    "routing": "",
    "max_parallel": "",
    "quota_probe": shlex.quote(str(SKILLS / "wave" / "scripts" / "quota-probe")),  # a path may hold spaces
}
LINE = re.compile(r"^([a-z_]+):\s*(.*?)\s*$")


def pairs(lines) -> dict[str, str]:
    values = {}
    for line in lines:
        match = LINE.match(line)
        if match:
            values[match.group(1)] = re.sub(r"\s{2,}#.*$", "", match.group(2)).strip()
    return values


def block(agents: Path) -> dict[str, str]:
    """The `key: value` lines under the `## jstack settings` heading, up to the next heading."""
    if not agents.is_file():
        return {}
    inside, kept = False, []
    for line in agents.read_text().splitlines():
        if re.match(r"^#{1,6}\s", line):
            inside = bool(re.match(r"^#{1,6}\s*jstack settings\s*$", line, re.I))
        elif inside:
            kept.append(line)
    return pairs(kept)


def user_values(env) -> dict[str, str]:
    path = Path(env.get("JSTACK_USER_SETTINGS") or Path.home() / ".config" / "jstack" / "settings")
    return pairs(path.read_text().splitlines()) if path.is_file() else {}


def default_branch(repo: Path) -> str:
    proc = subprocess.run(["git", "-C", str(repo), "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
                          capture_output=True, text=True)
    return proc.stdout.strip().removeprefix("origin/") if proc.returncode == 0 and proc.stdout.strip() else "main"


def resolve(repo: Path, env: dict[str, str] | None = None) -> dict[str, str]:
    env = os.environ if env is None else env
    configured, mine = block(repo / "AGENTS.md"), user_values(env)
    out: dict[str, str] = {}
    for key, default in DEFAULTS.items():
        if f"JSTACK_{key.upper()}" in env:
            out[key] = env[f"JSTACK_{key.upper()}"]
        elif key in configured:
            out[key] = configured[key]
        elif key in mine:
            out[key] = mine[key]
        else:
            out[key] = default if default is not None else default_branch(repo)
    return out


def glob_re(glob: str) -> re.Pattern:
    out, i = "", 0
    while i < len(glob):
        if glob[i:i + 3] == "**/":
            out, i = out + "(?:.*/)?", i + 3
        elif glob[i:i + 2] == "**":
            out, i = out + ".*", i + 2
        elif glob[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif glob[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(glob[i]), i + 1
    return re.compile("^" + out + "$")


def ui_files(values: dict[str, str], files: list[str]) -> list[str]:
    """The files that count as UI: those matching a glob of `ui_paths`. Empty `ui_paths` means none."""
    patterns = [glob_re(g.strip()) for g in values["ui_paths"].split(",") if g.strip()]
    return [f for f in files if any(p.match(f) for p in patterns)]


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("key", nargs="?")
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    values = resolve(args.repo)
    if args.key:
        if args.key not in values:
            print(f"jstack-settings: unknown key {args.key!r}; known: {', '.join(values)}", file=sys.stderr)
            sys.exit(2)
        print(values[args.key])
    elif args.json:
        print(json.dumps(values, indent=2))
    else:
        for key, value in values.items():
            print(f"{key}: {value}")


if __name__ == "__main__":
    main()
