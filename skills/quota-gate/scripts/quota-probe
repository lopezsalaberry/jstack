#!/usr/bin/env python3
"""quota-probe: report how much quota each provider account has left, from a plain file.

  quota-probe [--source FILE] [--max-age MINUTES] [--provider NAME]
  quota-probe --mark-exhausted NAME [--minutes N] [--reason TEXT]
  quota-probe --clear NAME

The source file has one line per account: `<provider> <account> <percent remaining>`.
Blank lines and lines starting with `#` are ignored. Whatever keeps that file fresh
(a cron job, a script that reads your providers' usage pages) is outside this tool.

Without --provider: print the file's lines, exit 0.
With --provider NAME, exit
  0  at least one account of NAME has more than 0% left
  1  NAME is listed and every account is at 0%
  2  unknown: no source, a source older than --max-age, or NAME not listed.
     Unknown is not exhaustion; the caller goes ahead and notes it.

Marks: when starting a model fails for quota, rate limit, authentication or unavailability, run
--mark-exhausted NAME. For the next N minutes (default 60) --provider NAME exits 1 whatever the
source says, so no other worker retries a provider that just refused. --clear NAME removes the
mark. Marks live in $JSTACK_QUOTA_MARKS or ~/.config/jstack/quota-marks.txt (per machine, not
per repo: quota belongs to the account), one line `<provider> <expires epoch> <reason>`.

Default source: $JSTACK_QUOTA_SOURCE, then ./.jstack/quota.txt, then ~/.config/jstack/quota.txt.
Default max age: $JSTACK_QUOTA_MAX_AGE_MINUTES or 30.

Hand-off: this script is only the default `quota_probe`. When the `quota_probe` setting (environment
JSTACK_QUOTA_PROBE or the repo's AGENTS.md) names another command, any call without --source runs that command
instead, so it makes no difference which of the two a caller reaches. A caller that ran this file directly used
to read "no quota source configured" as "unknown" for a provider the configured probe knew to be at 0%.

A bad argument exits 64. In this contract exit 2 means unknown, and a usage error must never look like it.
"""
from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path


def find_source(explicit: str | None) -> Path | None:
    candidates = [explicit, os.environ.get("JSTACK_QUOTA_SOURCE"), ".jstack/quota.txt",
                  str(Path.home() / ".config" / "jstack" / "quota.txt")]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return Path(candidate)
    return None


def parse(path: Path) -> list[tuple[str, str, float]]:
    rows = []
    for number, line in enumerate(path.read_text().splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        try:
            rows.append((parts[0], parts[1], float(parts[2].rstrip("%"))))
        except (IndexError, ValueError):
            print(f"quota-probe: {path}:{number}: expected '<provider> <account> <percent>'", file=sys.stderr)
            sys.exit(2)
    return rows


def marks_file() -> Path:
    return Path(os.environ.get("JSTACK_QUOTA_MARKS") or Path.home() / ".config" / "jstack" / "quota-marks.txt")


def live_marks(now: float) -> dict[str, tuple[float, str]]:
    path, found = marks_file(), {}
    if not path.is_file():
        return found
    for line in path.read_text().splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) >= 2:
            try:
                expires = float(parts[1])
            except ValueError:
                continue
            if expires > now:
                found[parts[0]] = (max(expires, found.get(parts[0], (0, ""))[0]), parts[2] if len(parts) > 2 else "")
    return found


def write_marks(marks: dict[str, tuple[float, str]]) -> None:
    path = marks_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(f"{p} {e:.0f} {r}\n" for p, (e, r) in sorted(marks.items())))


class Parser(argparse.ArgumentParser):
    def error(self, message: str) -> None:  # argparse exits 2 here, which this contract reads as "unknown"
        self.print_usage(sys.stderr)
        print(f"quota-probe: {message}", file=sys.stderr)
        sys.exit(64)


def configured_probe() -> list[str] | None:
    """The command of the `quota_probe` setting when it is not this script, else None (use this script)."""
    if os.environ.get("JSTACK_QUOTA_HANDOFF"):
        return None
    settings = Path(__file__).resolve().parents[2] / "jstack" / "scripts" / "jstack-settings"
    if not settings.is_file():
        return None
    try:
        out = subprocess.run([sys.executable, str(settings), "quota_probe"], capture_output=True, text=True, timeout=10)
        command = shlex.split(out.stdout.strip()) if out.returncode == 0 else []
        target = Path(command[0]) if "/" in command[0] else Path(shutil.which(command[0]) or "")
        if not command or not target.is_file() or not os.access(target, os.X_OK) or target.resolve() == Path(__file__).resolve():
            return None
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return None
    return command


def main() -> None:
    ap = Parser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--source")
    ap.add_argument("--provider")
    ap.add_argument("--mark-exhausted", metavar="NAME")
    ap.add_argument("--clear", metavar="NAME")
    ap.add_argument("--minutes", type=float, default=60)
    ap.add_argument("--reason", default="start failed")
    ap.add_argument("--max-age", type=float,
                    default=float(os.environ.get("JSTACK_QUOTA_MAX_AGE_MINUTES", "30")))
    args = ap.parse_args()
    now = time.time()
    if not args.source:
        command = configured_probe()
        if command:
            os.execvpe(command[0], command + sys.argv[1:], {**os.environ, "JSTACK_QUOTA_HANDOFF": "1"})
    if args.mark_exhausted or args.clear:
        marks = live_marks(now)
        if args.mark_exhausted:
            marks[args.mark_exhausted] = (now + args.minutes * 60, args.reason.replace("\n", " "))
            print(f"quota-probe: {args.mark_exhausted} marked exhausted for {args.minutes:g} min")
        else:
            marks.pop(args.clear, None)
            print(f"quota-probe: {args.clear} mark cleared")
        write_marks(marks)
        return
    if args.provider and args.provider in live_marks(now):
        print(f"quota-probe: {args.provider} is marked exhausted ({live_marks(now)[args.provider][1]})", file=sys.stderr)
        sys.exit(1)
    source = find_source(args.source)
    if source is None:
        print("quota-probe: unknown (no quota source configured)", file=sys.stderr)
        sys.exit(2)
    age = (time.time() - source.stat().st_mtime) / 60
    rows = parse(source)
    if not args.provider:
        for provider, account, percent in rows:
            print(f"{provider} {account} {percent:g}")
        return
    if age > args.max_age:
        print(f"quota-probe: unknown ({source} is {age:.0f} min old, limit {args.max_age:g})", file=sys.stderr)
        sys.exit(2)
    mine = [percent for provider, _, percent in rows if provider == args.provider]
    if not mine:
        print(f"quota-probe: unknown ({args.provider} is not listed in {source})", file=sys.stderr)
        sys.exit(2)
    sys.exit(0 if max(mine) > 0 else 1)


if __name__ == "__main__":
    main()
