#!/usr/bin/env python3
"""doctor: say what is missing before the first run.

  doctor [--repo PATH]

Prints one line per check: `ok`, `warn` or `FAIL`, then the check and what to do.
Exit 1 when a FAIL line was printed.
"""
from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKILLS = HERE.parents[1]
sys.path.insert(0, str(HERE))
import importlib.util  # noqa: E402
from importlib.machinery import SourceFileLoader  # noqa: E402

_loader = SourceFileLoader("jstack_settings", str(HERE / "jstack-settings"))
settings = importlib.util.module_from_spec(importlib.util.spec_from_loader("jstack_settings", _loader))
_loader.exec_module(settings)  # load_module() is gone in newer Pythons


def run(args: list[str], env: dict | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True, env=env)


def probe_contract(probe: list[str]) -> tuple[str, str]:
    """Walk the quota-gate contract with a throwaway name and marks file. A usage error that exits 2 reads as
    "unknown", so exit codes alone cannot tell a probe that says "no data" from one that did not understand us."""
    with tempfile.TemporaryDirectory() as tmp:
        env = {**os.environ, "JSTACK_QUOTA_MARKS": str(Path(tmp) / "marks.txt")}
        steps = [(["--provider", "doctor-check"], (0, 1, 2)), (["--mark-exhausted", "doctor-check", "--minutes", "1"], (0,)),
                 (["--provider", "doctor-check"], (1,)), (["--clear", "doctor-check"], (0,))]
        for args, expected in steps:
            result = run([*probe, *args], env=env)
            if result.returncode not in expected or "usage:" in result.stderr.lower():
                why = "printed a usage error" if "usage:" in result.stderr.lower() else f"exited {result.returncode}, expected {'/'.join(map(str, expected))}"
                return "FAIL", f"`{' '.join(args)}` {why}. The probe does not speak the quota-gate contract, so every provider would look unknown and no refusal would ever be marked"
    return "ok", "speaks the contract: --provider, --mark-exhausted, --clear; exit 2 means no data, which is not a block"


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    args = ap.parse_args()
    lines: list[tuple[str, str, str]] = []

    def say(level: str, name: str, detail: str = "") -> None:
        lines.append((level, name, detail))

    say("ok" if sys.version_info >= (3, 9) else "FAIL", "python3 >= 3.9", f"found {sys.version.split()[0]}")
    say("ok" if shutil.which("git") else "FAIL", "git", "" if shutil.which("git") else "install git")
    if shutil.which("gh"):
        auth = run(["gh", "auth", "status"])
        say("ok" if auth.returncode == 0 else "FAIL", "gh authenticated",
            "" if auth.returncode == 0 else "run `gh auth login`")
    else:
        say("FAIL", "gh", "install the GitHub CLI: https://cli.github.com")

    repo = args.repo
    inside = run(["git", "-C", str(repo), "rev-parse", "--is-inside-work-tree"]).returncode == 0 if shutil.which("git") else False
    if not inside:
        say("warn", "inside a git repo", f"{repo} is not a git work tree; repo checks skipped")
    else:
        remote = run(["git", "-C", str(repo), "remote", "get-url", "origin"])
        say("ok" if remote.returncode == 0 else "warn", "origin remote",
            "" if remote.returncode == 0 else "no `origin`; PR steps need one")
        values = settings.resolve(repo)
        configured = settings.block(repo / "AGENTS.md")
        say("ok" if configured else "warn", "jstack settings in AGENTS.md",
            "" if configured else "none found; defaults apply. Add a `## jstack settings` block (see the `jstack` skill)")
        probe = shlex.split(values["quota_probe"])
        if not probe or (not Path(probe[0]).exists() and not shutil.which(probe[0])):
            say("FAIL", "quota_probe command", f"{values['quota_probe']!r} not found")
        else:
            try:
                result = run([*probe, "--provider", "doctor-check"])
            except OSError as error:  # a check must report a problem, never crash on it
                say("FAIL", "quota_probe runs", f"cannot execute it: {error}")
            else:
                level, detail = probe_contract(probe)
                say(level, "quota_probe runs", detail)

    names = sorted(p.name for p in SKILLS.iterdir() if (p / "SKILL.md").exists())
    for target in (Path.home() / ".claude" / "skills", Path.home() / ".agents" / "skills", Path.home() / ".codex" / "skills"):
        if not target.exists():
            continue
        missing = [n for n in names if not (target / n / "SKILL.md").exists()]
        say("ok" if not missing else "warn", f"skills linked in {target}",
            "" if not missing else f"missing: {', '.join(missing)}; run ./install.sh (add --target for a folder it does not link by default)")

    for level, name, detail in lines:
        print(f"{level:4} {name}" + (f": {detail}" if detail else ""))
    sys.exit(1 if any(level == "FAIL" for level, _, _ in lines) else 0)


if __name__ == "__main__":
    main()
