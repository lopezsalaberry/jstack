#!/usr/bin/env python3
"""doctor: say what is missing before the first run.

  doctor [--repo PATH] [--check-updates]

Prints one line per check: `ok`, `warn` or `FAIL`, then the check and what to do.
Exit 1 when a FAIL line was printed.

--check-updates also asks the checkout's `origin` for its newest `vX.Y.Z` tag and warns when this
checkout is behind. It needs the network, so it is off by default; a failed lookup is a warning.
"""
from __future__ import annotations

import argparse
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKILLS = HERE.parents[1]
sys.path.insert(0, str(HERE))
import importlib.util  # noqa: E402
from importlib.machinery import SourceFileLoader  # noqa: E402

_loader = SourceFileLoader("jstack_settings", str(HERE / "jstack-settings"))
settings = importlib.util.module_from_spec(importlib.util.spec_from_loader("jstack_settings", _loader))
_loader.exec_module(settings)  # load_module() is gone in newer Pythons


def run(args: list[str], env: dict | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True, env=env)


def probe_contract(probe: list[str]) -> tuple[str, str]:
    """A probe only has to answer `--provider NAME` with exit 0, 1 or 2. A usage error that exits 2 reads as "unknown",
    so the exit code alone cannot tell a probe that says "no data" from one that did not understand the call."""
    result = run([*probe, "--provider", "doctor-check"])
    if result.returncode not in (0, 1, 2) or "usage:" in result.stderr.lower():
        why = "printed a usage error" if "usage:" in result.stderr.lower() else f"exited {result.returncode}, expected 0, 1 or 2"
        return "FAIL", f"`--provider doctor-check` {why}. The probe does not answer the question, so every provider would look unknown"
    return "ok", "answers --provider with 0 (quota), 1 (none) or 2 (no data, which is not a block)"


def ui_gate(repo: Path, values: dict) -> tuple[str, str]:
    """The UI design gate only applies to files that match `ui_paths`. A repo with a design system and no `ui_paths` has the
    gate off without any message (2026-11-10: 27 sessions edited UI files in five repos that all had a design system, and none
    ran the design check)."""
    tokens = values["design_tokens"]
    has_tokens = bool(tokens) and (repo / tokens).is_file()
    if values["ui_paths"] and has_tokens:
        return "ok", f"on for {values['ui_paths']}, tokens in {tokens}"
    if values["ui_paths"]:
        return "warn", f"`ui_paths` is set but {tokens!r} does not exist, so token-lint cannot run; fix `design_tokens` or add the file"
    if has_tokens:
        return "warn", (f"OFF: {tokens} exists but `ui_paths` is empty, so no change counts as a UI change and the design check never runs. "
                        "Add `ui_paths: <globs of the UI files>` to the `## jstack settings` block")
    return "ok", "no design tokens in this repo; nothing to gate"


CARD = re.compile(r"<!-- jstack-card -->.*?<!-- /jstack-card -->", re.S)


def card_state(repo: Path) -> tuple[str, str]:
    """The rules card is the only text every session is sure to read. It may sit in the repo's AGENTS.md or in a file
    the harness loads for every repo; an old or missing copy means the rules are not followed."""
    template = SKILLS.parent / "templates" / "AGENTS.md"
    shipped = CARD.search(template.read_text()) if template.is_file() else None
    if not shipped:
        return "warn", f"{template} has no rules card, so there is nothing to compare; install from a full clone"
    places = [repo / "AGENTS.md", Path.home() / ".claude" / "CLAUDE.md", Path.home() / ".codex" / "AGENTS.md"]
    old = None
    for place in places:
        found = CARD.search(place.read_text(errors="replace")) if place.is_file() else None
        if found and " ".join(found.group(0).split()) == " ".join(shipped.group(0).split()):
            return "ok", f"current, in {place}"
        old = old or (place if found else None)
    if old:
        return "warn", f"{old} carries an older or edited card: run `install.sh --card {old}`"
    return "warn", (f"no file an agent reads here carries the rules card, so the rules are not followed. Run `install.sh --card "
                    f"{repo / 'AGENTS.md'}` for this repo, or `--card` with the file your harness loads for every repo")


def newest_tag(checkout: Path) -> tuple:
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0",
           "GIT_SSH_COMMAND": os.environ.get("GIT_SSH_COMMAND", "ssh -o BatchMode=yes -o ConnectTimeout=5")}
    done = subprocess.run(["git", "-C", str(checkout), "ls-remote", "--tags", "--refs", "origin"],
                          capture_output=True, text=True, timeout=15, env=env)
    if done.returncode != 0:
        raise OSError(done.stderr.strip().splitlines()[-1] if done.stderr.strip() else f"git exited {done.returncode}")
    found = [tuple(map(int, m.groups())) for m in re.finditer(r"refs/tags/v(\d+)\.(\d+)\.(\d+)$", done.stdout, re.M)]
    if not found:
        raise OSError("origin has no vX.Y.Z tags")
    return max(found)


def checkout_freshness() -> tuple[str, str]:
    checkout = SKILLS.parent
    version_file = checkout / "VERSION"
    if not version_file.is_file() or not (checkout / ".git").exists():
        return "warn", "this copy of jstack is not a git checkout, so there is nothing to compare; install from a clone"
    mine = tuple(int(x) for x in version_file.read_text().strip().split("."))
    try:
        latest = newest_tag(checkout)
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        return "warn", f"could not ask origin for its newest tag ({error}); not checked"
    dotted = lambda v: ".".join(map(str, v))  # noqa: E731
    if latest > mine:
        return "warn", f"this checkout is {dotted(mine)} and origin has {dotted(latest)}: run `git pull --ff-only && ./install.sh` in {checkout}"
    return "ok", f"{dotted(mine)} (the newest tag on origin is {dotted(latest)})"


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    ap.add_argument("--check-updates", action="store_true", help="compare this checkout with origin's newest tag (network)")
    args = ap.parse_args()
    lines: list[tuple[str, str, str]] = []

    def say(level: str, name: str, detail: str = "") -> None:
        lines.append((level, name, detail))

    say("ok" if sys.version_info >= (3, 9) else "FAIL", "python3 >= 3.9", f"found {sys.version.split()[0]}")
    say("ok" if shutil.which("git") else "FAIL", "git", "" if shutil.which("git") else "install git")
    if shutil.which("gh"):
        auth = run(["gh", "auth", "status"])
        say("ok" if auth.returncode == 0 else "FAIL", "gh authenticated",
            "" if auth.returncode == 0 else "run `gh auth login`")
    else:
        say("FAIL", "gh", "install the GitHub CLI: https://cli.github.com")

    repo = args.repo
    inside = run(["git", "-C", str(repo), "rev-parse", "--is-inside-work-tree"]).returncode == 0 if shutil.which("git") else False
    if not inside:
        say("warn", "inside a git repo", f"{repo} is not a git work tree; repo checks skipped")
    else:
        remote = run(["git", "-C", str(repo), "remote", "get-url", "origin"])
        say("ok" if remote.returncode == 0 else "warn", "origin remote",
            "" if remote.returncode == 0 else "no `origin`; PR steps need one")
        values = settings.resolve(repo)
        configured = settings.block(repo / "AGENTS.md")
        say("ok" if configured else "warn", "jstack settings in AGENTS.md",
            "" if configured else "none found; defaults apply. Add a `## jstack settings` block (see the `jstack` skill)")
        level, detail = ui_gate(repo, values)
        say(level, "UI design gate", detail)
        level, detail = card_state(repo)
        say(level, "rules card", detail)
        unknown = sorted(set(configured) - set(settings.DEFAULTS))
        if unknown:
            say("warn", "settings this version does not read", f"{', '.join(unknown)}: remove them from the `## jstack settings` block")
        probe = shlex.split(values["quota_probe"])
        if not probe or (not Path(probe[0]).exists() and not shutil.which(probe[0])):
            say("FAIL", "quota_probe command", f"{values['quota_probe']!r} not found")
        else:
            try:
                level, detail = probe_contract(probe)
            except OSError as error:  # a check must report a problem, never crash on it
                level, detail = "FAIL", f"cannot execute it: {error}"
            say(level, "quota_probe runs", detail)

    if args.check_updates:
        level, detail = checkout_freshness()
        say(level, "jstack is the newest version", detail)

    names = sorted(p.name for p in SKILLS.iterdir() if (p / "SKILL.md").exists())
    for target in (Path.home() / ".claude" / "skills", Path.home() / ".agents" / "skills", Path.home() / ".codex" / "skills"):
        if not target.exists():
            continue
        missing = [n for n in names if not (target / n / "SKILL.md").exists()]
        say("ok" if not missing else "warn", f"skills linked in {target}",
            "" if not missing else f"missing: {', '.join(missing)}; run ./install.sh (add --target for a folder it does not link by default)")

    for level, name, detail in lines:
        print(f"{level:4} {name}" + (f": {detail}" if detail else ""))
    sys.exit(1 if any(level == "FAIL" for level, _, _ in lines) else 0)


if __name__ == "__main__":
    main()
