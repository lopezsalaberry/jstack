#!/usr/bin/env python3
"""wave-status: one table of every ticket in flight, read from RUNSTATE.md files.

  wave-status [--repo PATH] [--json]

Looks at every worktree of the repo (`git worktree list`) for a RUNSTATE.md at its root and reads
its header lines (Status, Done when, Metric, Baseline, Now, Next step; see the `jstack` skill).
A worktree without RUNSTATE.md is listed as `no RUNSTATE.md`. Read-only.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import time
from pathlib import Path

FIELDS = ("Status", "Done when", "Metric", "Baseline", "Now", "Next step")


def worktrees(repo: Path) -> list[tuple[Path, str]]:
    out = subprocess.run(["git", "-C", str(repo), "worktree", "list", "--porcelain"],
                         capture_output=True, text=True, check=True).stdout
    found, path, branch = [], None, "(detached)"
    for line in out.splitlines() + [""]:
        if line.startswith("worktree "):
            path, branch = Path(line[9:]), "(detached)"
        elif line.startswith("branch "):
            branch = line[7:].removeprefix("refs/heads/")
        elif not line and path is not None:
            found.append((path, branch))
            path = None
    return found


def read(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line in path.read_text().splitlines():
        match = re.match(r"^(" + "|".join(FIELDS) + r"):\s*(.*?)\s*$", line)
        if match and match.group(1) not in values:
            values[match.group(1)] = match.group(2)
    return values


def age(path: Path) -> str:
    minutes = int((time.time() - path.stat().st_mtime) / 60)
    return f"{minutes}m" if minutes < 120 else f"{minutes // 60}h"


def rows(repo: Path) -> list[dict[str, str]]:
    result = []
    for path, branch in worktrees(repo):
        state = path / "RUNSTATE.md"
        if not state.is_file():
            result.append({"branch": branch, "status": "no RUNSTATE.md", "metric": "", "next": "", "age": ""})
            continue
        v = read(state)
        metric = f"{v.get('Metric', '?')}: {v.get('Baseline', '?')} -> {v.get('Now', '?')}"
        result.append({"branch": branch, "status": v.get("Status", "?"), "metric": metric,
                       "next": v.get("Next step", ""), "age": age(state)})
    return result


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    try:
        table = rows(args.repo)
    except subprocess.CalledProcessError:
        print(f"wave-status: {args.repo} is not a git repo", file=sys.stderr)
        sys.exit(2)
    if args.json:
        print(json.dumps(table, indent=2))
        return
    print("| branch | status | metric (baseline -> now) | next step | updated |")
    print("|---|---|---|---|---|")
    for r in table:
        print(f"| {r['branch']} | {r['status']} | {r['metric']} | {r['next']} | {r['age']} ago |" if r["age"]
              else f"| {r['branch']} | {r['status']} | | | |")


if __name__ == "__main__":
    main()
