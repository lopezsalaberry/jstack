#!/usr/bin/env python3
"""publish: put a ticket's screenshots where the person reviewing the PR can see them.

  publish TICKET [--repo PATH] [--pr N] [--branch NAME] [--web-base URL] [--max-mb N] [--dry-run]

`.artifacts/<ticket>/` stays out of git, so a PR that says "screenshots are under .artifacts/" shows nothing to the person who
reads it. In two weeks of four real repos, 3 of 214 UI pull requests showed an image and 103 pointed at that folder. This copies
the images and videos of `.artifacts/<ticket>/` to a branch of `origin` that no change is merged from (default `jstack-evidence`;
one commit per run, files under `<ticket>/<revision>/`) with git plumbing, so the working tree, the index and the branches of the
repo are not touched. It prints markdown that shows them. With --pr N it puts that markdown in the PR description between two
comment markers and replaces the block of an earlier run.

The pictures are links to files in the repo, so they show to anyone who can open the repo. Only GitHub origins give such links;
for any other origin (or --dry-run's push) use --web-base https://github.com/<owner>/<repo>, or the images stay local: the files
are listed and the exit code is 2.

Images over --max-mb (default 10) are skipped and named. Exit 0 published (or --dry-run), 1 nothing to publish or a failure,
2 the origin cannot serve images or a usage error. A video is a link, an image is a picture.
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

IMAGES = {".png", ".jpg", ".jpeg", ".gif", ".webp"}
VIDEOS = {".mp4", ".mov", ".webm"}
BEGIN = "<!-- jstack-evidence:begin -->"
END = "<!-- jstack-evidence:end -->"


class Fail(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


def git(root: Path, *args: str, env: dict | None = None, stdin: str | None = None) -> str:
    done = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, input=stdin,
                          env={**os.environ, "GIT_TERMINAL_PROMPT": "0", **(env or {})})
    if done.returncode != 0:
        raise Fail(f"git {' '.join(args[:2])} failed: {done.stderr.strip() or done.stdout.strip()}")
    return done.stdout.strip()


def web_base_of(url: str) -> str | None:
    found = re.match(r"^(?:git@|ssh://git@|https?://(?:[^@/]+@)?)github\.com[:/]+([^/]+)/(.+?)(?:\.git)?/?$", url.strip())
    return f"https://github.com/{found.group(1)}/{found.group(2)}" if found else None


def collect(source: Path, max_bytes: int):
    files, skipped = [], []
    for path in sorted(p for p in source.rglob("*") if p.is_file() and p.suffix.lower() in IMAGES | VIDEOS):
        (files if path.stat().st_size <= max_bytes else skipped).append(path)
    return files, skipped


def identity(root: Path) -> dict:
    def conf(key: str, fallback: str) -> str:
        done = subprocess.run(["git", "-C", str(root), "config", key], capture_output=True, text=True)
        return done.stdout.strip() or fallback
    name, email = conf("user.name", "jstack"), conf("user.email", "jstack@localhost")
    return {"GIT_AUTHOR_NAME": name, "GIT_AUTHOR_EMAIL": email, "GIT_COMMITTER_NAME": name, "GIT_COMMITTER_EMAIL": email}


def commit_files(root: Path, branch: str, ticket: str, revision: str, files: list[Path], source: Path, push: bool):
    """Add the files to the evidence branch with plumbing and (unless dry-run) push it. Returns the commit sha and the paths."""
    parent = None
    if git(root, "ls-remote", "origin", f"refs/heads/{branch}"):
        git(root, "fetch", "-q", "origin", branch)
        parent = git(root, "rev-parse", "FETCH_HEAD")
    paths = {}
    with tempfile.TemporaryDirectory() as tmp:
        env = {"GIT_INDEX_FILE": str(Path(tmp) / "index"), **identity(root)}
        if parent:
            git(root, "read-tree", parent, env=env)
        for file in files:
            relative = f"{ticket}/{revision}/{file.relative_to(source).as_posix()}"
            blob = git(root, "hash-object", "-w", str(file))
            git(root, "update-index", "--add", "--cacheinfo", f"100644,{blob},{relative}", env=env)
            paths[file] = relative
        tree = git(root, "write-tree", env=env)
        if parent and git(root, "rev-parse", f"{parent}^{{tree}}") == tree:
            return parent, paths  # the same files were published before
        command = ["commit-tree", tree, "-m", f"evidence {ticket} {revision}"] + (["-p", parent] if parent else [])
        commit = git(root, *command, env=env)
    if push:
        git(root, "push", "-q", "origin", f"{commit}:refs/heads/{branch}")
    return commit, paths


def markdown(web: str, commit: str, ticket: str, revision: str, paths: dict) -> str:
    lines = [BEGIN, f"### Screenshots ({ticket} at {revision})", ""]
    for file, relative in paths.items():
        url = f"{web}/blob/{commit}/{relative}?raw=true"
        label = file.stem
        lines.append(f"![{label}]({url})" if file.suffix.lower() in IMAGES else f"[{label} (video)]({url})")
    lines += ["", END]
    return "\n".join(lines)


def put_in_pr(root: Path, number: str, block: str) -> None:
    done = subprocess.run(["gh", "pr", "view", number, "--json", "body", "-q", ".body"], cwd=root, capture_output=True, text=True)
    if done.returncode != 0:
        raise Fail(f"gh pr view {number} failed: {done.stderr.strip()}")
    body = re.sub(rf"\n*{re.escape(BEGIN)}.*?{re.escape(END)}\n*", "\n\n", done.stdout, flags=re.S).rstrip()
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as handle:
        handle.write(f"{body}\n\n{block}\n")
    try:
        edit = subprocess.run(["gh", "pr", "edit", number, "--body-file", handle.name], cwd=root, capture_output=True, text=True)
    finally:
        os.unlink(handle.name)
    if edit.returncode != 0:
        raise Fail(f"gh pr edit {number} failed: {edit.stderr.strip()}")


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("ticket")
    ap.add_argument("--repo", type=Path, default=Path.cwd())
    ap.add_argument("--pr")
    ap.add_argument("--branch", default="jstack-evidence")
    ap.add_argument("--web-base")
    ap.add_argument("--max-mb", type=float, default=10)
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args(argv)
    try:
        root = Path(git(args.repo, "rev-parse", "--show-toplevel"))
        source = root / ".artifacts" / args.ticket
        if not source.is_dir():
            raise Fail(f"{source} does not exist; capture the screenshots there first (see the evidence skill)")
        files, skipped = collect(source, int(args.max_mb * 1024 * 1024))
        for path in skipped:
            print(f"publish: skipped {path.name}: over {args.max_mb:g} MB", file=sys.stderr)
        if not files:
            raise Fail(f"no images or videos in {source}")
        revision = git(root, "rev-parse", "--short", "HEAD")
        origin = subprocess.run(["git", "-C", str(root), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
        web = (args.web_base or "").rstrip("/") or (web_base_of(origin) if origin else None)
        if not web:
            names = "\n".join(f"  {p}" for p in files)
            raise Fail(f"origin ({origin or 'none'}) cannot serve images, so these stay local; show them in your message "
                       f"and attach them by hand, or pass --web-base https://github.com/<owner>/<repo>:\n{names}", code=2)
        commit, paths = commit_files(root, args.branch, args.ticket, revision, files, source, push=not args.dry_run)
        block = markdown(web, commit, args.ticket, revision, paths)
        if args.pr and not args.dry_run:
            put_in_pr(root, args.pr, block)
            print(f"publish: {len(files)} file(s) on {args.branch}, PR #{args.pr} description updated", file=sys.stderr)
        else:
            print(f"publish: {len(files)} file(s) {'prepared' if args.dry_run else 'on ' + args.branch}; paste the block below into the PR description",
                  file=sys.stderr)
        print(block)
        return 0
    except Fail as error:
        print(f"publish: {error}", file=sys.stderr)
        return error.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
